n = int(input("Введите число больше или равно 2: "))
max_1 = 0
max_2 = 0
if n >= 2:
    for _ in range(n):
        num = int(input("Введите число последовательности: "))
        if num > max_1:
            max_2 = max_1
            max_1 = num
        elif num > max_2:
            max_2 = num
        else:
            print()
    print(f"Первое макс число из последовательности: {max_1}")
    print(f"Второе макс число из последовательности: {max_2}")
else:
    print("Ошибка! Вы ввели число меньше 2!")
